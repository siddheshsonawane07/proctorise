/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob: https://gbpylpgsnodbbsowjgpz.supabase.co; media-src 'self' blob:; connect-src 'self' https://gbpylpgsnodbbsowjgpz.supabase.co wss://gbpylpgsnodbbsowjgpz.supabase.co; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
